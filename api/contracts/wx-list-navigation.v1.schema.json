{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "微信主页列表单步导航任务",
  "type": "object",
  "required": ["task_id", "task_type", "device_id", "wechat_account_id", "idempotency_key", "expires_at", "contract_version", "payload"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"const": "wx_list_navigate"},
    "device_id": {"type": "string", "minLength": 1},
    "wechat_account_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "contract_version": {"const": "wx-list-navigation.v1"},
    "correlation_id": {"type": "string"},
    "payload": {
      "type": "object",
      "required": ["navigation_id", "navigation_profile", "action", "step_index"],
      "properties": {
        "navigation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "navigation_profile": {
          "type": "object",
          "required": ["profile_id", "version"],
          "properties": {
            "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
            "version": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "action": {"type": "string", "enum": ["next", "top"]},
        "step_index": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx.local/contracts/probe-path-observation.v1.schema.json",
  "title": "Probe path observation v1",
  "description": "探头实体路径证据（规范第 22.14 节）。该证据证明实体运动，不证明屏幕接触；至少 3 点、最大采样间隔 300ms 由运行时在 schema 外核对。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "binding", "frame_seqs", "points", "verified", "reason_code"],
  "properties": {
    "contract_version": {"const": "probe-path-observation.v1"},
    "plan_id": {"$ref": "#/$defs/text"},
    "binding": {"type": "object"},
    "frame_seqs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "points": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame_seq", "x_camera_px", "y_camera_px", "at_ms"],
        "properties": {
          "frame_seq": {"type": "integer", "minimum": 1},
          "x_camera_px": {"type": "number"},
          "y_camera_px": {"type": "number"},
          "at_ms": {"type": "integer", "minimum": 0}
        }
      }
    },
    "verified": {"type": "boolean"},
    "reason_code": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}

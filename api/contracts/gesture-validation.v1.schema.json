{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx.local/contracts/gesture-validation.v1.schema.json",
  "title": "Gesture self-test task v1",
  "description": "校准后自动手势自检任务（规范第 12.2/22.12 节）。gesture_profile_version=0 仅允许出现在本任务（尚无自动档案时自举）；通用路径与自动导航不得用 0 绕过资格。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "contract_version",
    "device_id",
    "idempotency_key",
    "payload",
    "expires_at",
    "correlation_id"
  ],
  "properties": {
    "task_id": {
      "$ref": "#/$defs/text"
    },
    "task_type": {
      "const": "gesture_self_test"
    },
    "contract_version": {
      "const": "gesture-validation.v1"
    },
    "device_id": {
      "$ref": "#/$defs/text"
    },
    "idempotency_key": {
      "$ref": "#/$defs/text"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "$ref": "#/$defs/text"
    },
    "policy_context": {
      "type": "object"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unsignedInt": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "actions",
        "rules_version"
      ],
      "properties": {
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device_id",
            "daemon_session",
            "camera_id",
            "camera_device_unique_id",
            "binding_revision",
            "calibration_fingerprint",
            "frame_width",
            "frame_height",
            "coordinate_frame_hash",
            "gesture_profile_version",
            "recipe_version"
          ],
          "properties": {
            "device_id": {
              "$ref": "#/$defs/text"
            },
            "daemon_session": {
              "$ref": "#/$defs/text"
            },
            "camera_id": {
              "$ref": "#/$defs/text"
            },
            "camera_device_unique_id": {
              "$ref": "#/$defs/text"
            },
            "binding_revision": {
              "$ref": "#/$defs/unsignedInt"
            },
            "calibration_fingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "frame_width": {
              "type": "integer",
              "minimum": 1
            },
            "frame_height": {
              "type": "integer",
              "minimum": 1
            },
            "coordinate_frame_hash": {
              "$ref": "#/$defs/sha256"
            },
            "gesture_profile_version": {
              "$ref": "#/$defs/unsignedInt"
            },
            "recipe_version": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "scroll_up",
              "scroll_down",
              "system_back_left",
              "system_back_right",
              "system_home",
              "double_tap"
            ]
          }
        },
        "rules_version": {
          "$ref": "#/$defs/text"
        },
        "vision_only": {
          "type": "boolean",
          "description": "视觉优先（2026-09-30 拍板）：跳过手势页会话，滑动效果以相机前后帧光流判定；仅纯滑动集生效，混合集强制页面采样路径",
          "default": false
        }
      }
    }
  }
}

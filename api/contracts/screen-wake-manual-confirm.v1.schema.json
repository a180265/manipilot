{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx.local/contracts/screen-wake-manual-confirm.v1.schema.json",
  "title": "Manual screen wake single field confirmation v1",
  "description": "Operator-only, single-use confirmation that the phone is still at the displayed reference position, so one bound wake task may use the frozen verified position when the live pose is unobservable. Never issues motion by itself; grants no unlock, click, swipe or automatic-policy permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "idempotency_key", "binding", "reference_evidence_id", "operator_id", "reason", "correlation_id", "client_request_id"],
  "properties": {
    "contract_version": {"const": "screen-wake-manual-confirm.v1"},
    "task_id": {"$ref": "#/$defs/text"},
    "idempotency_key": {"$ref": "#/$defs/text"},
    "reference_evidence_id": {"$ref": "#/$defs/text"},
    "operator_id": {"$ref": "#/$defs/text"},
    "reason": {"$ref": "#/$defs/text"},
    "correlation_id": {"$ref": "#/$defs/text"},
    "client_request_id": {"$ref": "#/$defs/text"},
    "binding": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "daemon_session", "camera_id", "camera_device_unique_id", "binding_revision", "calibration_fingerprint", "frame_width", "frame_height"],
      "properties": {
        "device_id": {"$ref": "#/$defs/text"},
        "daemon_session": {"$ref": "#/$defs/text"},
        "camera_id": {"$ref": "#/$defs/text"},
        "camera_device_unique_id": {"$ref": "#/$defs/text"},
        "binding_revision": {"type": "integer", "minimum": 0},
        "calibration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "frame_width": {"type": "integer", "minimum": 1},
        "frame_height": {"type": "integer", "minimum": 1}
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "confirmation_id", "task_id", "expires_at"],
      "properties": {
        "contract_version": {"const": "screen-wake-manual-confirm.v1"},
        "confirmation_id": {"type": "string", "pattern": "^swmc-[0-9a-f]{32,}$"},
        "task_id": {"$ref": "#/$defs/text"},
        "expires_at": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    }
  }
}

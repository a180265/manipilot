{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wx:design:calibrated-scroll-routes:v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": "calibrated-scroll-routes.design.v1"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/entry"}}
  },
  "definitions": {
    "schema_ref": {
      "type": "string",
      "pattern": "^(contract|records|observation)\\.schema\\.json#/definitions/[a-z_]+$"
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "transport", "entrypoint", "request_schema", "response_schema",
        "http_success", "http_errors", "authority", "side_effect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "transport": {"enum": ["http", "trusted_call", "store", "artifact"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "request_schema": {"anyOf": [{"$ref": "#/definitions/schema_ref"}, {"type": "null"}]},
        "response_schema": {"$ref": "#/definitions/schema_ref"},
        "http_success": {"type": "array", "uniqueItems": true, "items": {"enum": [200]}},
        "http_errors": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["status", "schema"],
          "properties": {
            "status": {"enum": [400, 403, 404, 409, 410, 422, 503]},
            "schema": {"const": "contract.schema.json#/definitions/http_error"}
          }
        }},
        "authority": {"enum": ["read", "task_submit", "human_review", "original_task_lease", "store_only", "archive_only"]},
        "side_effect": {"enum": ["none", "enqueue_once", "swipe_at_most_once", "review_only", "persist_only"]}
      }
    }
  }
}

          {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/draft"},
          {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/session"},
          {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/capture"},

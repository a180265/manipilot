    },
    "state_row": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "state_key", "device_id", "principal_id", "revision", "json"],
      "properties": {
        "kind": {"$ref": "#/definitions/state_kind"},
        "state_key": {"$ref": "urn:wx:design:layout-reuse:common#/definitions/sha"},
        "device_id": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:common#/definitions/id"}, {"type": "null"}]},
        "principal_id": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:common#/definitions/id"}, {"type": "null"}]},
        "revision": {"$ref": "urn:wx:design:layout-reuse:common#/definitions/positive"},

        "after_revision": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:common#/definitions/uint"}, {"type": "null"}]},
        "phase": {"enum": ["prepared", "committed", "aborted", "unknown"]},
        "version_ref": {"$ref": "urn:wx:design:layout-reuse:common#/definitions/nullable_ref"},
        "response": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:wire#/definitions/write_response"}, {"type": "null"}]},
        "error": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:api#/definitions/error"}, {"type": "null"}]},

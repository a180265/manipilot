        "request": {"$ref": "urn:wx:design:layout-reuse:wire#/definitions/write_request"},
        "request_hash": {"$ref": "urn:wx:design:layout-reuse:common#/definitions/sha"},
        "planned_response": {"$ref": "urn:wx:design:layout-reuse:wire#/definitions/write_response"},
        "files": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/definitions/file_plan"}},
        "pointer_before": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:region#/definitions/pointer"}, {"type": "null"}]},
        "pointer_after": {"anyOf": [{"$ref": "urn:wx:design:layout-reuse:region#/definitions/pointer"}, {"type": "null"}]},
        "mutations": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/definitions/mutation"}},

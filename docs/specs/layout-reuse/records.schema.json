    "file_plan": {
      "type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "byte_size"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"},
        "sha256": {"$ref": "urn:wx:design:layout-reuse:common#/definitions/sha"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 209715200}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false, "required": ["table", "key", "expected_revision", "value"],
      "properties": {
        "table": {"enum": ["drafts", "sessions", "issues", "reviews", "captures", "catalog", "exports", "region_drafts", "review_revisions", "adaptation_assets"]},
        "key": {"$ref": "urn:wx:design:layout-reuse:common#/definitions/id"},

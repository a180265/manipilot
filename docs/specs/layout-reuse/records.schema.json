    "state_cas_case": {
      "$comment": "Offline state-table insert/update, not an HTTP request.",
      "type": "object", "additionalProperties": false, "required": ["before", "after", "expected_revision"],
      "properties": {
        "before": {"anyOf": [{"$ref": "#/definitions/state_row"}, {"type": "null"}]},

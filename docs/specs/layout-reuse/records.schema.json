        {"if": {"properties": {"kind": {"const": "session"}}}, "then": {"properties": {"json": {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/session"}}}},
        {"if": {"properties": {"kind": {"const": "capture"}}}, "then": {"properties": {"json": {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/capture"}}}},
        {"if": {"properties": {"kind": {"const": "evidence"}}}, "then": {"properties": {"json": {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/evidence"}}}},
        {"if": {"properties": {"kind": {"const": "region_draft"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/region_draft"}}}},
        {"if": {"properties": {"kind": {"const": "region_preview"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/region_preview"}}}},
        {"if": {"properties": {"kind": {"const": "adaptation_preview"}}}, "then": {"properties": {"json": {"$ref": "urn:wx:design:layout-reuse:layout#/definitions/preview_record"}}}},
        {"if": {"properties": {"kind": {"const": "rollback_preview"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/rollback_preview"}}}},
        {"if": {"properties": {"kind": {"const": "package_import_preview"}}}, "then": {"properties": {"json": {"$ref": "urn:wx:design:layout-reuse:package#/definitions/preview_record"}}}},
        {"if": {"properties": {"kind": {"const": "package_export"}}}, "then": {"properties": {"json": {"$ref": "urn:wx:design:layout-reuse:package#/definitions/export_record"}}}},
        {"if": {"properties": {"kind": {"const": "cursor"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/cursor"}}}},
        {"if": {"properties": {"kind": {"const": "review_revision"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/review_revision"}}}},
        {"if": {"properties": {"kind": {"const": "adaptation_asset"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/adaptation_asset"}}}},
        {"if": {"properties": {"kind": {"const": "catalog"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/catalog"}}}},
        {"if": {"properties": {"kind": {"const": "intent"}}}, "then": {"properties": {"json": {"$ref": "#/definitions/intent"}}}}
